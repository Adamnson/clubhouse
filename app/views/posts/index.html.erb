<h1>The conversation so far:</h1>
<div>
 
  <% @posts.each do |post| %>
    <% if user_signed_in? %>
      <p><%= post.user.email %></p>
    <% else %>
      <p><%= "anon" %></p>
    <% end %>
    <% post.body.split("\n").each do |line| %>
      <div>
        <p><%= line %></p>
        <% if user_signed_in? && (post.user.email.eql? current_user.email) %>
          <p><%= link_to "Edit", edit_user_post_path(current_user, post.id)%>
        <% end %>
      </div>
    <% end %>
  <% end %>
  <% if user_signed_in? %>
    <%= button_to "New Post", new_user_post_path(current_user.id), :method => "get" %>
  <% else %>
    <p>Log in to post</p>
  <% end %>
</div>
